{
  "name": "tcg-inventory-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test:catalog": "node --import tsx --test src/catalog/*.test.ts",
    "test:inventory": "node --import tsx --test src/inventory/*.test.ts",
    "test": "npm run test:catalog && npm run test:inventory",
    "inventory:import": "tsx src/inventory/import-v2-workbook.ts",
    "inventory:review": "tsx src/inventory/review-mapping.ts",
    "inventory:review:runtime": "tsx src/inventory/review-mapping-runtime.ts",
    "inventory:image": "tsx src/inventory/card-image-ingest.ts",
    "inventory:invoice": "tsx src/inventory/invoice-ingest.ts",
    "catalog:import": "tsx src/catalog/import-tcgdex.ts",
    "catalog:validate": "tsx src/catalog/validate.ts",
    "catalog:merge": "tsx src/catalog/merge-catalog.ts",
    "inventory:sheets:sync": "tsx src/inventory/google-sheets-sync.ts",
    "inventory:backup": "tsx src/inventory/backup-cli.ts",
    "inventory:verify": "tsx src/inventory/verify-cli.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "discord.js": "^14.21.0",
    "dotenv": "^17.2.2",
    "openai": "^7.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
